# 복사해서 .env.local 로 만들고 값을 채우세요. (.env.local 은 커밋하지 않음)
# Neon 대시보드 > Connect 에서 복사한 연결 문자열
DATABASE_URL=

# Better Auth 세션 서명 키. openssl rand -base64 32 로 만든다
BETTER_AUTH_SECRET=

# 자동 수집 (workers/collect). 로컬 dry-run(npm run collect:dry-run)에서 쓴다
# Kakao Developers > 앱 > 플랫폼 키 > REST API 키 (Daum 블로그 검색)
KAKAO_REST_API_KEY=
# Google Cloud 콘솔 > YouTube Data API v3 사용 설정 > API 키 (YouTube Data API만 쓰도록 제한)
YOUTUBE_API_KEY=
# Claude Console > API Keys에서 만든 키 (sk-ant-로 시작, 워크스페이스 ID wrkspc_ 아님). 자동 수집 2단계 Haiku 판단·초안용
# 수집 전용 키를 따로 만들고 Console에서 월 사용 한도를 걸어 둔다
ANTHROPIC_API_KEY=

# 수집 전용 DB 계정(collector)의 연결 문자열. neon/collect.sql로 만든다 (함수 2개만 실행 가능)
# npm run collect:db-check에서 쓴다. 시험할 때는 Neon 테스트 브랜치(collect-test)의 주소
COLLECT_DATABASE_URL=
